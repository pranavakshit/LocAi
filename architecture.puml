@startuml
' ==========================================================
' LocAi Architecture v2.1.0 – Capability-Driven Agent Platform
' ==========================================================

package "LocAi Core (Python Backend)" {
  [FastAPI Server\n(server.py)]    as server     <<Component>>
  [Event Bus\n(events.py)]         as eventbus   <<Component>>
  [Chat Router\n(routers.py)]      as router     <<Component>>
  [Context Engine\n(context.py)]   as context    <<Component>>
  [Inference Provider\n(providers.py)] as provider <<Component>>
  [Settings Manager\n(settings.py)] as settings  <<Component>>
  [Conversation Service\n(services/)]  as convservice <<Service>>
  [Agent Tools\n(tools.py)]        as tools      <<Component>>
}

package "Client Layer" {
  [Native UI Wrapper\n(modern_app.py)] as gui <<pywebview>>
  package "React SPA (ui/)" {
    [UI Core\n(App.tsx)] as react <<Frontend>>
    [Artifact Canvas\nPlayground] as canvas <<Component>>
    [Models Manager] as models <<Component>>
  }
  [CLI] as cli <<Component>>
}

package "Runtime & Bootstrapping" {
  [LocAi.exe\n(launcher.py)] as launcher <<Dual-Mode Entrypoint>>
  [System Tray\n(pystray)] as tray <<Component>>
}

' ==========================================================
' Internal Data Stores
' ==========================================================
database "User Data\n(%USERPROFILE%\\LocAi\\userdata\\)" {
  node "projects.json" as projects
  node "config.json" as config
  database "locai_v2.db\n(SQLite + FTS5)" as db_v2
  node "local_rag_db\n(ChromaDB)" as db
}

' ==========================================================
' External Services
' ==========================================================
cloud "Ollama API\nhttp://localhost:11434" as ollama <<Service>>

' ==========================================================
' Relationships – Execution Flow
' ==========================================================
launcher --> tray : Spawns Background Daemon
launcher --> gui : Starts Native Window (if UI mode)

gui --> react : Renders web assets
react --> server : HTTP/WebSocket (Port 8000)
cli --> server : HTTP Commands

server --> settings : Manage Settings & Projects
server --> convservice : Manage V2 Conversations
convservice --> db_v2 : Read/Write SQLite

server --> eventbus : Emits API Events
eventbus <--> router : Subscribes to ChatRequests

router --> context : Gathers context before inference
context --> db : Queries project vector store
router --> provider : Streams LLM tokens
provider --> ollama : Sends generation request

router --> tools : Executes Autonomous Agent Tools (ReAct)
tools --> settings : Accesses workspace path

settings --> projects : Reads/Writes
settings --> config : Reads/Writes

' ==========================================================
' Additional Notes
' ==========================================================
note right of router
  • Central Intelligence Hub
  • Capability-Driven (Injects System Prompts)
  • Implements ReAct Tool Calling Loop
end note

note right of eventbus
  • Pub/Sub Architecture
  • Allows plugins/routers to observe tokens
end note

@enduml
